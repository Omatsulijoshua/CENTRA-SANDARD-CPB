rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return signedIn() && (request.auth.token.role == 'OWNER' || request.auth.token.role == 'ADMIN');
    }

    match /kyc/{businessId}/{fileName} {
      allow read: if signedIn() && ((isOwnerOrAdmin() && request.auth.token.businessId == businessId) || request.auth.token.role == 'ADMIN');
      allow write: if isOwnerOrAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /receipts/{businessId}/{fileName} {
      allow read: if signedIn() && (request.auth.token.businessId == businessId || request.auth.token.role == 'ADMIN');
      allow write: if false;
    }
  }
}
