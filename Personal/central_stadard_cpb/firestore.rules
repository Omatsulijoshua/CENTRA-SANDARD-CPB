rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /companies/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /billCategories/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    match /appBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cards/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /cardOrders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /linkedBankCards/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /paymentIntents/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /children/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.parentUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.parentUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /childTransactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.parentUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /supportTickets/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
