rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function businessId() {
      return signedIn() ? request.auth.token.businessId : null;
    }

    function employeeId() {
      return signedIn() ? request.auth.token.employeeId : null;
    }

    function isOwner() {
      return role() == 'OWNER';
    }

    function isEmployee() {
      return role() == 'EMPLOYEE';
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    match /businesses/{id} {
      allow read: if isAdmin() || (isOwner() && businessId() == id);
      allow create: if isOwner();
      allow update: if isAdmin() || (isOwner() && businessId() == id);
      allow delete: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isAdmin() || (isOwner() && resource.data.businessId == businessId()) || (isEmployee() && id == employeeId());
      allow create, update, delete: if isAdmin() || isOwner();
    }

    match /transactions/{id} {
      allow read: if isAdmin()
        || (isOwner() && resource.data.businessId == businessId())
        || (isEmployee() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.businessId == businessId()
        && request.resource.data.amount <= 100000;
      allow update, delete: if isAdmin();
    }

    match /nfcSessions/{id} {
      allow read: if isAdmin()
        || (isOwner() && resource.data.businessId == businessId())
        || (isEmployee() && resource.data.employeeId == employeeId());
      allow create: if signedIn() && request.resource.data.businessId == businessId();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin() || (isOwner() && resource.data.businessId == businessId());
      allow write: if false;
    }

    match /fraudFlags/{id} {
      allow read: if isAdmin() || (isOwner() && resource.data.businessId == businessId());
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (isOwner() && resource.data.businessId == businessId());
      allow write: if isAdmin();
    }

    match /kycDocuments/{id} {
      allow read: if isAdmin() || (isOwner() && resource.data.businessId == businessId());
      allow create: if isOwner() && request.resource.data.businessId == businessId();
      allow update, delete: if isAdmin();
    }
  }
}
