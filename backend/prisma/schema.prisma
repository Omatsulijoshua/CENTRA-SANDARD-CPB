generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  firebaseUid  String?  @unique
  email        String?  @unique
  phone        String?  @unique
  fullName     String
  role         UserRole
  passwordHash String?
  isActive     Boolean  @default(true)
  balance      Decimal  @default(0)
  accountNumber String? @unique
  kycStatus    KycStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBusinesses Business[] @relation("BusinessOwner")
  employeeProfile  Employee?
  devices          Device[]
  auditLogs        AuditLog[]
  cards            Card[]
  cardOrders       CardOrder[]
  linkedBankCards  LinkedBankCard[]
  children         ChildAccount[]
  personalTransactions Transaction[] @relation("PersonalUserTransactions")
}

model Business {
  id             String   @id @default(uuid())
  ownerId        String
  name           String
  cacNumber      String?
  category       String
  taxId          String?
  address        String
  kycStatus      KycStatus @default(PENDING)
  status         BusinessStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner       User         @relation("BusinessOwner", fields: [ownerId], references: [id])
  branches    Branch[]
  employees   Employee[]
  wallets     Wallet[]
  limits      PaymentLimit[]
  transactions Transaction[]
}

model Employee {
  id                 String   @id @default(uuid())
  userId             String   @unique
  businessId         String
  branchId           String?
  displayName        String
  receivingAccount   String   @unique
  nfcReceiverId      String   @unique
  qrPayload          String
  status             EmployeeStatus @default(ACTIVE)
  nfcEnabled         Boolean @default(true)
  dailyLimitAmount   Decimal @default(500000)
  transactionLimit   Decimal @default(100000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  business    Business   @relation(fields: [businessId], references: [id])
  branch      Branch?    @relation(fields: [branchId], references: [id])
  permissions EmployeePermission[]
  transactions Transaction[]
}

model EmployeePermission {
  id          String @id @default(uuid())
  employeeId  String
  permission  Permission
  enabled     Boolean @default(true)
  employee    Employee @relation(fields: [employeeId], references: [id])
}

model Wallet {
  id          String @id @default(uuid())
  businessId  String
  currency    String @default("NGN")
  balance     Decimal @default(0)
  ledgerBalance Decimal @default(0)
  status      WalletStatus @default(ACTIVE)
  business    Business @relation(fields: [businessId], references: [id])
}

model Transaction {
  id             String @id @default(uuid())
  businessId     String?
  employeeId     String?
  userId         String?
  type           TransactionType
  channel        TransactionChannel
  direction      String?
  amount         Decimal
  currency       String @default("NGN")
  status         TransactionStatus
  provider       String?
  providerRef    String?
  riskScore      Int @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  user     User?     @relation("PersonalUserTransactions", fields: [userId], references: [id])
  nfcSession NfcSession?
}

model NfcSession {
  id            String @id @default(uuid())
  transactionId String @unique
  businessId    String
  employeeId    String?
  receiverDeviceId String?
  status        NfcSessionStatus
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Device {
  id          String @id @default(uuid())
  userId      String
  fingerprint String @unique
  platform    String
  model       String?
  trusted     Boolean @default(false)
  rooted      Boolean @default(false)
  emulator    Boolean @default(false)
  lastSeenAt  DateTime?
  user        User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String @id @default(uuid())
  actorUserId String?
  businessId  String?
  action      String
  targetType  String?
  targetId    String?
  ipAddress   String?
  deviceId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User? @relation(fields: [actorUserId], references: [id])
}

model FraudFlag {
  id            String @id @default(uuid())
  businessId    String?
  employeeId    String?
  transactionId String?
  severity      FraudSeverity
  reason        String
  score         Int
  resolved      Boolean @default(false)
  createdAt     DateTime @default(now())
}

model Branch {
  id          String @id @default(uuid())
  businessId  String
  name        String
  address     String?
  business    Business @relation(fields: [businessId], references: [id])
  employees   Employee[]
}

model Notification {
  id          String @id @default(uuid())
  businessId  String?
  userId      String?
  channel     NotificationChannel
  title       String
  body        String
  status      NotificationStatus @default(QUEUED)
  createdAt   DateTime @default(now())
}

model KycDocument {
  id          String @id @default(uuid())
  businessId  String
  type        KycDocumentType
  fileUrl     String
  status      KycStatus @default(PENDING)
  createdAt   DateTime @default(now())
}

model PaymentLimit {
  id          String @id @default(uuid())
  businessId  String
  scope       LimitScope
  amount      Decimal
  period      LimitPeriod
  business    Business @relation(fields: [businessId], references: [id])
}

enum UserRole {
  OWNER
  EMPLOYEE
  ADMIN
  USER
}

enum BusinessStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  FROZEN
  REMOVED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum Permission {
  RECEIVE_PAYMENT
  VIEW_OWN_TRANSACTIONS
  NFC_RECEIVE
  QR_RECEIVE
  VERIFY_PAYMENT
}

enum TransactionType {
  BANK_TRANSFER
  NFC_TAP
  QR_PAYMENT
  WALLET_TRANSFER
  POS_RECEIVE
  USSD_CONFIRMATION
  INVOICE
}

enum TransactionChannel {
  NFC
  QR
  TRANSFER
  WALLET
  POS
  USSD
  INVOICE
}

enum TransactionStatus {
  INITIATED
  PENDING_PROVIDER
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  FLAGGED
}

enum NfcSessionStatus {
  WAITING_FOR_TAP
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  PROVIDER_REQUIRED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  VOICE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum KycDocumentType {
  CAC
  BVN
  NIN
  SELFIE
  UTILITY_BILL
  TAX_ID
}

enum LimitScope {
  BUSINESS
  EMPLOYEE
  BRANCH
}

enum LimitPeriod {
  PER_TRANSACTION
  DAILY
  WEEKLY
  MONTHLY
}

model Card {
  id          String   @id @default(uuid())
  userId      String
  cardNumber  String   @unique
  cardType    String
  holderName  String
  expiryDate  String
  cvv         String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model CardOrder {
  id              String   @id @default(uuid())
  userId          String
  cardType        String
  deliveryAddress String
  holderName      String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model LinkedBankCard {
  id                String   @id @default(uuid())
  userId            String
  bankName          String
  holderName        String
  network           String   @default("Visa")
  last4             String
  maskedPan         String
  expiryMonth       String
  expiryYear        String
  status            String   @default("active")
  tokenStatus       String   @default("not_tokenized")
  defaultForPayment Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model ChildAccount {
  id            String   @id @default(uuid())
  parentUserId  String
  name          String
  username      String   @unique
  pin           String
  balance       Decimal  @default(0)
  dailyLimit    Decimal  @default(0)
  cardLimit     Decimal  @default(0)
  transferLimit Decimal  @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  parent        User     @relation(fields: [parentUserId], references: [id])
}

model AppBanner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  actionUrl String?
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentIntent {
  id                String   @id @default(uuid())
  userId            String
  sourceType        String
  cardId            String?
  linkedCardId      String?
  amount            Decimal
  currency          String   @default("NGN")
  channel           String   @default("nfc_pos")
  authMethod        String   @default("biometric_or_pin")
  status            String
  provider          String
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
